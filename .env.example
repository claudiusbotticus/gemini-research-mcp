# ── Gemini (existente) ───────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Telegram Bot ─────────────────────────────────────────────
# Obtén el token con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID del chat donde quieres recibir los mensajes
# Puedes obtenerlo hablando con @userinfobot en Telegram
TELEGRAM_CHAT_ID=-1001234567890

# ── Notion ───────────────────────────────────────────────────
# Token de integración: notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de la página donde se actualizarán los mercados
# Es el UUID en la URL de la página de Notion
NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Monitor config ────────────────────────────────────────────
# Intervalo de polling en segundos (default: 300 = 5 min)
POLL_INTERVAL_SECONDS=300
